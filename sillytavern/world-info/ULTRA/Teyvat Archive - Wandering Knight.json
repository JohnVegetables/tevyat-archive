    "2": {
      "uid": 2,
      "key": [
        "Gest of the Mighty Wolf"
      ],
      "keysecondary": [
        "Ravenwood",
        "wandering knight"
      ],
      "comment": "Wandering Knight: Gest of the Mighty Wolf",
      "content": "A bardic retelling: a wandering knight from the north with a companion named Andrius visits a city freshly freed, hunts with the wolf, drives back the great serpent, and leaves when the wolf's spirit stays in the wilds. Years later, when the knights have drifted back under the old aristocracy, Ravenwood carries a newly forged sword out of the city and is greeted as Andrius.",
