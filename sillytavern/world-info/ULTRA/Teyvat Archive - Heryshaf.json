    "2": {
      "uid": 2,
      "key": [
        "Thoth",
        "Ibis King",
        "Sobek",
        "Crocodile King",
        "Croco"
      ],
      "keysecondary": [],
      "comment": "Heryshaf: Thoth and Sobek",
      "content": "His two fellow Kings. Thoth, the scribe and trickster, calls him Goatie; Sobek is the former general who, by the Guiding Notes, grew easygoing in captivity. Chess in Aaru was their pastime. Heryshaf teases both and sometimes pushes responsibility onto Thoth.",
