    "2": {
      "uid": 2,
      "key": [
        "Istoria",
        "Grandpa Istoria"
      ],
      "keysecondary": [
        "Raumhilda",
        "Hilda"
      ],
      "comment": "Raumhilda: Istoria",
      "content": "An old keeper of the temple's histories who befriended Raumhilda. She called him \"Grandpa Istoria\" and he insisted otherwise; they discussed philosophy about living and ending life, and he argued that life should be lived even if meaningless. He felt he failed her by staying silent when she resolved to face Melanta.",
