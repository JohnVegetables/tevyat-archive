    "4": {
      "uid": 4,
      "key": [
        "Snegovik",
        "Snegurochka",
        "soulless"
      ],
      "keysecondary": [
        "Pavlina"
      ],
      "comment": "Pavlina: Snegovik and Souls",
      "content": "Snegovik are fae created without flesh and blood and without complete souls. They become whole only through love, by taking another's soul, which is why their love stories end badly. Pavlina wants to give her people souls without sacrificing anyone's love, using the power of the Eye of Graeae.",
