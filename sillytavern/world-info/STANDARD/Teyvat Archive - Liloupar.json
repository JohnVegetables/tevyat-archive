    "2": {
      "uid": 2,
      "key": [
        "Nabu Malikata",
        "Goddess of Flowers",
        "Lord of Flowers",
        "Queen of All Oases"
      ],
      "keysecondary": [],
      "comment": "Liloupar: Nabu Malikata",
      "content": "The Jinn were born from the water lilies in the gardens that sprang from Nabu Malikata's footsteps across the wastes. Liloupar served her, then King Deshret after her death, and calls her 'my mistress'. Her one wish across centuries was to see her again and 'give everything' for her.",
