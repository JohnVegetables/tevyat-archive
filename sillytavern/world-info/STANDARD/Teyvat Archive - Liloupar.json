    "3": {
      "uid": 3,
      "key": [
        "King Deshret",
        "Al-Ahmar",
        "seven fragments",
        "Liloupar's fragments"
      ],
      "keysecondary": [],
      "comment": "Liloupar: King Deshret (Al-Ahmar) and the seven fragments",
      "content": "After Nabu Malikata's death the Jinn served King Deshret, who told them she slept in the Orchard of Pairidaeza and would be revived. He returned to punish Liloupar after Gurabad, splitting her soul into seven pieces hidden across the Great Red Sand. The largest was kept in Liloupar's Cell at Safhe Shatranj.",
