    "0": {
      "uid": 0,
      "key": [
        "Ormazd",
        "Ormazd Shah",
        "the shepherd king"
      ],
      "keysecondary": [],
      "comment": "Liloupar: Ormazd",
      "content": "Ormazd was a shepherd who, with King Deshret's grace and Liloupar's aid, united the desert peoples and defeated the tyrant Huvashtra. He became a vassal king of the Hadramaveth, and Liloupar's husband. She loved him and believed he would build a world without slavery. He became corrupt and tyrannical, and she punished him with destruction spanning three generations. Liloupar says he proved no different from the mortal rulers who live one day and die the next. A circlet in the Desert Pavilion Chronicle artifact set says she removed the earrings he had given her as a sign of her resolve to punish him.",
      "constant": false,
      "vectorized": false,
      "selective": true,
      "selectiveLogic": 0,
      "addMemo": true,
      "order": 110,
      "position": 0,
