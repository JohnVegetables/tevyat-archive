    "2": {
      "uid": 2,
      "key": [
        "Janusz",
        "Oskari",
        "Lightkeeper",
        "Ratnik",
        "Jelly"
      ],
      "keysecondary": [
        "Dreadshade Mire",
        "Serpent of All Evils"
      ],
      "comment": "Serpent of All Evils: Janusz and Oskari",
      "content": "Janusz, a seasoned Lightkeeper, and his apprentice Oskari were on a routine patrol when the seal failed. Janusz was wounded, Oskari took shelter in a house near Pillar 2. They explain the Serpent's story and the Lightkeepers' duties, and thank the Traveler after the fight. Janusz jokes about his late cat Jelly; Oskari is nervous but dutiful.",
