    "2": {
      "uid": 2,
      "key": [
        "Unknown Sanctuary",
        "chained crystal",
        "Abyss Herald",
        "Frost Fall"
      ],
      "keysecondary": [],
      "comment": "Vedrfolnir: The Unknown Sanctuary",
      "content": "In the Sumeru Archon Quest, the Traveler relived their sibling's memory beside Chlothar (Eide). In a hidden sanctuary they found a chained crystal, bowed to by hilichurls and guarded by an Abyss Herald. A voice in their heads said it was only a \"Sinner\", not a god, and urged them to become a transcendent one. Chlothar received Abyssal power from it.",
