    "4": {
      "uid": 4,
      "key": [
        "Rerir",
        "Rächer of Solnari",
        "Abyssal Whisper",
        "Tholindis"
      ],
      "keysecondary": [],
      "comment": "Vedrfolnir: Rerir and the Abyssal Whisper",
      "content": "In Rerir's memories (All Is Foretold), Vedrfolnir advised Rerir to find another fiancee, since the marriage was unlikely to end happily. A whispering voice urged Rerir to let Tholindis go, and Rerir became sure it was Vedrfolnir's. In the cell, Vedrfolnir laughed, \"So, you hear it too\", which leaves it unclear whose voice it was.",
