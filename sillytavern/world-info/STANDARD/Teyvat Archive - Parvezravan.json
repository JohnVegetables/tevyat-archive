    "1": {
      "uid": 1,
      "key": [
        "Jinn machines",
        "Jinn-driven machines",
        "Jinn fragments"
      ],
      "keysecondary": [
        "Gurabad",
        "Parvezravan"
      ],
      "comment": "Parvezravan: Jinn Machines of Gurabad",
      "content": "At Parvezravan's request Liloupar designed machines driven by Jinn remnants and inspired him to build a colossal one in a dream. The Jinn that ran them were made by Shirin and were mindless and malformed. They produced great wealth and displaced slave labour; the records speak of workshops, flying shuttles, 'springs of power' and slaves who could earn release. The nobles also used Jinn-fragment weapons and constructs against dissenters.",
      "constant": false,
      "vectorized": false,
      "selective": true,
      "selectiveLogic": 0,
