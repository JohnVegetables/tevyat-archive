    "8": {
      "uid": 8,
      "key": [
        "Azhdaha"
      ],
      "keysecondary": [
        "Mountain Shaper",
        "Moon Carver",
        "adepti"
      ],
      "comment": "Mountain Shaper: Azhdaha",
      "content": "Mountain Shaper and Moon Carver, with a third adeptus whom the sources do not name, were summoned by Rex Lapis against Azhdaha: he lured the dragon into a cavern the three had created and they sealed its entrance. A world-quest relic shows their story in carved patterns (the third adeptus's image deliberately ground away), and the wiki reads the crane as Mountain Shaper and the deer as Moon Carver.",
