    "5": {
      "uid": 5,
      "key": [
        "Rex Lapis",
        "Morax",
        "Rite of Descension"
      ],
      "keysecondary": [
        "Mountain Shaper",
        "Jiehu",
        "adepti"
      ],
      "comment": "Mountain Shaper: Rex Lapis and the Rite of Descension",
      "content": "Mountain Shaper learns of the Rite of Descension and Rex Lapis's reported assassination from the Traveler. He says Rex Lapis charged the adepti with protecting Liyue, which they honoured by withdrawing into the mountains as the people prospered. He later meets Rex Lapis as Zhongli in Lantern Rite scenes.",
