    "6": {
      "uid": 6,
      "key": [
        "Anastasya",
        "Zapolyarny Palace",
        "tea meeting",
        "Celestial Nail"
      ],
      "keysecondary": [
        "Naberius",
        "Rhinedottir"
      ],
      "comment": "Naberius: The Tea Meeting with the Tsaritsa",
      "content": "At Zapolyarny Palace, Rhinedottir met Anastasya while Naberius interjected: she cautioned against revealing sensitive information, and judged that Ronova's Authority had likely been reclaimed once the agreed window had passed. She said the Tsaritsa's act of defiance was not enough for a Celestial Nail but merited punishment. Rhinedottir spared the Tsaritsa, and Naberius complained that Snezhnaya would only escalate.",
