      "key": [
        "Cyno",
        "General Mahamatra",
        "audit",
        "Mahamatra"
      ],
      "keysecondary": [
        "Azar",
        "Grand Sage",
        "Akademiya"
      ],
      "comment": "Azar: Cyno's audit",
      "content": "Cyno found that the Akademiya's project files had gaps and that the errors came from Azar himself. When he requested an audit, Azar refused with the line that the General Mahamatra's power is granted by the sages and he has no right to judge them. Cyno resigned and went into exile in the desert. On Jnagarbha Day he cornered Azar in the Sanctuary of Surasthana and demanded that he answer to the Archon.",
