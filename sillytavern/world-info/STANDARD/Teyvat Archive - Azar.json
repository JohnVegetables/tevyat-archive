    "7": {
      "uid": 7,
      "key": [
        "entrance exam",
        "desert-folk policy",
        "Darshan assignment"
      ],
      "keysecondary": [
        "Azar",
        "Grand Sage",
        "desertfolk"
      ],
      "comment": "Azar: Desert-folk admissions policy",
      "content": "Under Azar's administration desert-folk students could be assigned a Darshan without the entrance exam. Nefer's Character Story 1 shows her placed in Vahumana this way by a scholar \"following the rules\", who warns Cyrus of \"trouble from Azar's ilk\". In her story quest she finds Cyrus's letter of protest to Grand Sage Azar about desert students' unequal education, which was never delivered. The wiki credits the rule to Azar personally; canon only implies it.",
