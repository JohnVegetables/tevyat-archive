    "2": {
      "uid": 2,
      "key": [
        "Alhaitham",
        "Jnagarbha Day",
        "Scribe",
        "Knowledge Capsule"
      ],
      "keysecondary": [
        "Azar",
        "Grand Sage"
      ],
      "comment": "Azar: Alhaitham and Jnagarbha Day",
      "content": "Jnagarbha Day is when scholars enter their reports into the Akasha. Alhaitham, the Scribe, brought the Traveler and Paimon to Azar's office as bait. Azar guessed the whole plan, ordered Alhaitham exiled to Aaru Village after he seemed to go mad and attack, and locked the Traveler and Paimon in the confinement room. He believed the matter settled; in reality Alhaitham's capsule carried a forged order, and Nilou's dance at the gate drew the guards into the city.",
