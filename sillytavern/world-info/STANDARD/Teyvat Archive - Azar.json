    "3": {
      "uid": 3,
      "key": [
        "Sanctuary of Surasthana",
        "Lesser Lord Kusanali",
        "Nahida"
      ],
      "keysecondary": [
        "Azar",
        "Grand Sage",
        "imprisoned"
      ],
      "comment": "Azar: Nahida and the Sanctuary of Surasthana",
      "content": "The sages confined the Archon in the Sanctuary of Surasthana, where entry was forbidden even to Akademiya staff. On Jnagarbha Day the Akasha order made Azar expect her absence, and from where he stood the cage looked empty until she reappeared. After she was freed, she showed mercy and he went into exile.",
