    "8": {
      "uid": 8,
      "key": [
        "Akasha",
        "Akasha Terminal",
        "Akasha System"
      ],
      "keysecondary": [
        "Azar",
        "Grand Sage"
      ],
      "comment": "Azar: Akasha System",
      "content": "The Akasha is the network that stores and shares knowledge to everyone wearing an Akasha Terminal. Azar used it to issue orders, predict people's behaviour and implant expectations, which made him expect Nahida's absence. It is also his blind spot: the system's output shaped what he could see.",
