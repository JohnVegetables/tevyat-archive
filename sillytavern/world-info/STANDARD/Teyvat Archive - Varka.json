    "3": {
      "uid": 3,
      "key": [
        "northern expedition",
        "Favonius expedition",
        "expeditionary force",
        "Varka's expedition"
      ],
      "keysecondary": [],
      "comment": "Varka: The Northern Expedition",
      "content": "About half a year before the Traveler's arrival, Varka led the Knights' elite north with about eighty percent of their manpower, leaving Jean in charge. He went with little intelligence because he knew the Abyss was brewing in the north and could threaten all of Teyvat. The force included Seamus Pegg, Mika and Lohen. It did not expect to end up in Nod-Krai.",
      "constant": false,
      "vectorized": false,
