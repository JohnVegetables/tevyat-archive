    "3": {
      "uid": 3,
      "key": [
        "prism",
        "memory prism",
        "seminar under the tree"
      ],
      "keysecondary": [
        "Hroptatyr",
        "The Wise"
      ],
      "comment": "Hroptatyr: The Prism Memory",
      "content": "A prism, engraved with Abyssal power, stored his memory of a seminar under the tree. When the Harbingers opened the notebook it activated, and the Traveler, Pierro and the Harbingers each spoke with him. Pierro believes his nostalgia was genuine, but calls the echo the person Hroptatyr gave up on.",
