    "2": {
      "uid": 2,
      "key": [
        "notebook",
        "blessing of immortality",
        "curse of immortality",
        "Authority of Death"
      ],
      "keysecondary": [
        "Hroptatyr",
        "The Wise"
      ],
      "comment": "Hroptatyr: The Curse of Immortality (his notebook)",
      "content": "His notebook records that the Crimson Moon holds a Death authority that can be extracted, and that using it would make a person unable to die. He first called it \"the blessing of immortality\" and later crossed that out and wrote \"the curse of immortality\". He decided this was no blessing, and that the research should be sealed forever.",
