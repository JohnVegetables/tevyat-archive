    "1": {
      "uid": 1,
      "key": [
        "Ivanovna",
        "Ioanna Ivanovna",
        "I. Ivanovna N.",
        "first Mayor"
      ],
      "keysecondary": [],
      "comment": "Pulcinella: Ioanna Ivanovna",
      "content": "Ioanna Ivanovna N., codename J, was a former Hexenzirkel member with no magic or combat training who became the first Mayor of Snezhnograd and first Speaker of the Veche. Pulcinella was made her pupil; a fae apprenticed to a human was read as the Tsaritsa's warning to the old fae order. She excelled at weaving conspiracies without leaving traces. He succeeded her.",
      "constant": false,
      "vectorized": false,
      "selective": true,
