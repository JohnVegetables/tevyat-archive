    "11": {
      "uid": 11,
      "key": [
        "Dottore",
        "Nahida",
        "Segment"
      ],
      "keysecondary": [
        "letter",
        "Sumeru",
        "Pulcinella",
        "Rooster",
        "Gnoses"
      ],
      "comment": "Pulcinella: Dottore and the Sumeru letter",
      "content": "Pulcinella wrote to Nahida disowning the rogue subordinates of Dottore who attacked Sumeru, promising they would be dealt with and that supplies were being sent to help reconstruction. Nahida judged the letter well calculated to absolve the Fatui. Centuries earlier he had met a 25-year-old Segment of Dottore in a cafeteria and, shortly after, a 35-year-old one, and was left puzzled.",
