    "2": {
      "uid": 2,
      "key": [
        "Snezhnograd Veche",
        "Veche State Hall",
        "Veche"
      ],
      "keysecondary": [],
      "comment": "Pulcinella: The Snezhnograd Veche",
      "content": "Snezhnaya's legislature, founded by the Tsaritsa to replace the fae aristocracy. It sits in the Veche State Hall, decides by majority vote and is chaired by Pulcinella. Harbingers commonly sit in it: in the 7.0 session Pantalone defends the finances, Tartaglia speaks for the armed forces and Sandrone for the data, alongside members such as Chugunov, boss of the Iskra Manufacturing Plant. House Strivozha holds only a few seats, fewer than the merchant class.",
      "constant": false,
      "vectorized": false,
