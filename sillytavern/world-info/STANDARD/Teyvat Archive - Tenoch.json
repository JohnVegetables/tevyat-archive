    "5": {
      "uid": 5,
      "key": [
        "Tenochtzitoc",
        "Easybreeze Holiday Resort"
      ],
      "keysecondary": [
        "Tenoch"
      ],
      "comment": "Tenoch: Tenochtzitoc and the resort legend",
      "content": "Easybreeze Holiday Resort's on-site actors play members of the Tenochtzitoc tribe, and the actor Papar plays the hero as \"Tenoyollotzin\", reciting lines from the Talking Stick legend. This is a theme-park tribute, not history; during the quest Enjou is found to have been inside the costume. Enjou separately says Tenoch was the last survivor of Tenochtzitoc, but he is an unreliable source.",
