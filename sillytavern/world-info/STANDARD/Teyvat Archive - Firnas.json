    "2": {
      "uid": 2,
      "key": [
        "Temple of Silence",
        "Akasha Terminal replacement"
      ],
      "keysecondary": [
        "Firnas"
      ],
      "comment": "Firnas: The Temple of Silence plan",
      "content": "When the Akademiya considers using ancient technology in the Temple of Silence as a substitute for the Akasha Terminal, Rushd and Shakir call it risky. Firnas judges the plan sound and the risks manageable, but warns that the modifications are enormous and will take many scholars, including Kaveh and Faruzan, working full time. He therefore urges the sages to move quickly.",
