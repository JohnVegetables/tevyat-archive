    "2": {
      "uid": 2,
      "key": [
        "Kun Jun"
      ],
      "keysecondary": [],
      "comment": "Azhdaha: Kun Jun",
      "content": "Kun Jun is a young artisan from a family of famous craftsmen, hired by Uncle Dai to survey rocks for the missing miners. His body was possessed by a fragment of Azhdaha, the part that kept the benevolent memories and could not recall its purpose. He read ore memories, became fixated on finding Dragonfall, and remembered everything when he touched the stone tablet at the tree.",
