    "6": {
      "uid": 6,
      "key": [
        "Seven Sovereigns",
        "Archon War",
        "Geo Dragon Sovereign"
      ],
      "keysecondary": [],
      "comment": "Azhdaha: Archon War and the Seven Sovereigns",
      "content": "Azhdaha fought alongside Morax in the Archon War and is counted among the Seven Sovereigns, the dragon lords of the old world; the English localisation derives \"Dragon Sovereign\" from his own title \"dragon king\". The wiki also groups Dvalin with the Sovereigns as the current Anemo dragon (an inference from his title and quest groupings), but canon records no meeting between him and Azhdaha.",
