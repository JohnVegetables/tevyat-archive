    "3": {
      "uid": 3,
      "key": [
        "Hyperborea",
        "Celestial Nail",
        "war of funerary flame"
      ],
      "keysecondary": [
        "Koitar",
        "Anacharsis"
      ],
      "comment": "Koitar: Hyperborea's Fall",
      "content": "Koitar and Anacharsis led Hyperborea for thirty years in defiance of the Heavenly Principles. The Principles destroyed the city with Celestial Nails around the time of the war of funerary flame. The two fled, were caught, and were punished with separation and memory loss.",
