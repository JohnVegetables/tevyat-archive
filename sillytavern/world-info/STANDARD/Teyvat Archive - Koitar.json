    "2": {
      "uid": 2,
      "key": [
        "Royal Court of the Seelie",
        "Amsvartnir"
      ],
      "keysecondary": [
        "Koitar",
        "Seelie",
        "lyre"
      ],
      "comment": "Koitar: The Royal Court of the Seelie",
      "content": "A hidden court atop Amsvartnir, invisible to mortals by day, built of stone pillars and golden beams with no windows. Koitar wept there for her lost memories among Seelie kin she no longer knew. A melody heard by those who strum a lyre near the temple is linked to her.",
