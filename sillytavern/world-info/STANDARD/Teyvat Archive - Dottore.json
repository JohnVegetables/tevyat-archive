    "3": {
      "uid": 3,
      "key": [
        "Segment 35",
        "Segments of Dottore",
        "Anomalous Tree Marrow"
      ],
      "keysecondary": [
        "Dottore",
        "Zandik",
        "Omega Build"
      ],
      "comment": "Dottore: The Segments",
      "content": "The Segments are independent copies of Zandik frozen at different ages, made from rare materials, perhaps Irminsul wood, and part of his soul. Item text names ages 8, 18, 25, 35, 45 and 65. They called the original Zandik or 'the main'; Segment 35 (the Omega Build) considers itself the most selfish of them.",
