    "6": {
      "uid": 6,
      "key": [
        "Columbina",
        "Damselette",
        "kuuvahki",
        "Light Realm"
      ],
      "keysecondary": [
        "Dottore",
        "sister",
        "Zandik"
      ],
      "comment": "Dottore: Columbina, his younger sister",
      "content": "While Columbina was a Harbinger, Dottore often asked her to help with his kuuvahki and Light Realm research; she obliged a few times but found it dull. He claimed to see her as a younger sister, and for him family meant using her: 'What's a little discomfort among family?' She says he meant it sincerely and never harmed her directly, but it reminded her of the Frostmoon Scions and she stopped attending.",
