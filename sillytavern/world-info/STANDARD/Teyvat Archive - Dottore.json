    "2": {
      "uid": 2,
      "key": [
        "Tatarasuna",
        "Escher",
        "Niwa",
        "Kabukimono",
        "Mikage Furnace"
      ],
      "keysecondary": [
        "Dottore",
        "Scaramouche",
        "Wanderer"
      ],
      "comment": "Dottore: Tatarasuna and Scaramouche",
      "content": "About four centuries ago he posed as the Fontainian engineer Escher at Tatarasuna and fed the Mikage Furnace materials that slowly released Tatarigami, causing sickness and a near-critical furnace. He killed the Armory Officer Niwa Hisahide to cover his tracks and removed his heart. He gave the Kabukimono a device holding the heart and lied that it belonged to an innocent servant Niwa had killed. He said he only wanted to see how the puppet would react to betrayal.",
