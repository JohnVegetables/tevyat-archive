    "2": {
      "uid": 2,
      "key": [
        "Descending Moon",
        "Dottore",
        "Ancient Moon's Remnants"
      ],
      "keysecondary": [
        "Pulonia"
      ],
      "comment": "Pulonia: Descending Moon",
      "content": "Pulonia arrived with Sandrone and charged Dottore with a flying kick, but Dottore, armed with the Three Moons' power, struck him down with a rain of Ancient Moon's Remnants. Afterwards Sandrone found him in worse shape than herself, having spent his last critical energy protecting the Wanderer's core and the numerological array. His surviving algorithms were partly imported into Sandrone's body.",
