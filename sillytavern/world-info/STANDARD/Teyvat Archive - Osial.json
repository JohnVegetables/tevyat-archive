    "2": {
      "uid": 2,
      "key": [
        "Turning Point",
        "Guizhong Ballista"
      ],
      "keysecondary": [
        "Osial",
        "adepti"
      ],
      "comment": "Osial: Turning Point (battle at the Jade Chamber)",
      "content": "Ningguang gathered the Qixing, Millelith and adepti against Osial. Cloud Retainer, Moon Carver and Mountain Shaper operated the upgraded Guizhong Ballistae while Fatui forces attacked them. Ganyu, Xiao and Madame Ping lent the Traveler their powers. Osial smashed the Ballistae, then Ningguang sacrificed the Jade Chamber, dropping it on him with the Traveler's help, and the god was suppressed.",
