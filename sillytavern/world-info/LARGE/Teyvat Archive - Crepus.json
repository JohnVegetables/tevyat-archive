    "4": {
      "uid": 4,
      "key": [
        "Inspector Eroch",
        "Eroch the Inspector"
      ],
      "keysecondary": [],
      "comment": "Crepus: Eroch",
      "content": "Eroch was the Knights' Inspector and part of Crepus's generation. He ordered Diluc to conceal the truth of Crepus's death, then took credit for the drake's defeat. The Knights exposed him as a traitor who had unsealed Ursa and worked with Dottore.\n\nVarka's letter refuses Eroch's theft of the credit and says it belongs to Crepus. Eroch died by his own hand when Varka cornered him.",
      "constant": false,
      "vectorized": false,
      "selective": true,
      "selectiveLogic": 0,
      "addMemo": true,
