    "4": {
      "uid": 4,
      "key": [
        "Belyi Tsar",
        "Pale Star Court",
        "Zapolyarny Palace"
      ],
      "keysecondary": [
        "Rotwang",
        "Professor",
        "Rauthvangi"
      ],
      "comment": "Rotwang: Court of the Belyi Tsar",
      "content": "At court he was the Tsar's favourite through alchemy and astrology and a source of banquet legends. Nobles called him the mad monk in private. He knew of the Tsar's secret revolt and scorned him for never looking up at the stars; he was sent to Nod-Krai as the Tsar's envoy.",
