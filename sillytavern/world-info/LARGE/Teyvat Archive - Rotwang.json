    "5": {
      "uid": 5,
      "key": [
        "pitch-black Elysium",
        "Elysium",
        "Apaosha's mirror"
      ],
      "keysecondary": [
        "Rotwang",
        "Professor",
        "Rauthvangi"
      ],
      "comment": "Rotwang: Khaenri'ah and the Pitch-black Elysium",
      "content": "In Khaenri'ah, under Irmin, stargazing was forbidden. Rauthvangi, a novice monk, cleaned dust from a mirror and saw the Abyss, which captivated him. He was tried for forbidden study, expelled from the Universitas Magistrorum and exiled without defending himself.",
