{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "id_list": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "classification": {
      "enum": [
        "confirmed",
        "strongly_supported",
        "inferred",
        "disputed",
        "unknown",
        "noncanon"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "source.schema.json"
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "target",
        "type",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "type": "string",
          "minLength": 2
        },
        "summary": {
          "type": "string",
          "minLength": 5
        },
        "classification": {
          "enum": [
            "confirmed",
            "strongly_supported",
            "inferred",
            "disputed",
            "unknown",
            "noncanon"
          ]
        },
        "since": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+\\.\\d+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "topic",
        "classification",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 3
        },
        "classification": {
          "enum": [
            "confirmed",
            "strongly_supported",
            "inferred",
            "disputed",
            "unknown",
            "noncanon"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fact",
              "visibility"
            ],
            "additionalProperties": false,
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 5
              },
              "learned": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "visibility": {
                "enum": [
                  "public",
                  "secret",
                  "restricted",
                  "disputed"
                ]
              }
            }
          }
        },
        "does_not_know": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fact"
            ],
            "additionalProperties": false,
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 5
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "believes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "belief",
              "reality",
              "classification"
            ],
            "additionalProperties": false,
            "properties": {
              "belief": {
                "type": "string"
              },
              "reality": {
                "type": "string"
              },
              "classification": {
                "enum": [
                  "confirmed",
                  "strongly_supported",
                  "inferred",
                  "disputed",
                  "unknown",
                  "noncanon"
                ]
              }
            }
          }
        }
      }
    },
    "wi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "keys2": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "logic": {
          "enum": [
            "and_any",
            "not_all",
            "not_any",
            "and_all"
          ]
        },
        "order": {
          "type": "integer"
        },
        "constant": {
          "type": "boolean"
        },
        "book": {
          "type": "string"
        },
        "exclude": {
          "type": "boolean",
          "description": "Do not emit a main World Info entry for this entity."
        }
      }
    },
    "header_common": {
      "type": "object",
      "required": [
        "id",
        "entity_type",
        "name",
        "aliases",
        "summary_line",
        "introduced_in",
        "spoiler_level",
        "sources",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "entity_type": {
          "enum": [
            "character",
            "npc",
            "historical_figure",
            "location",
            "faction",
            "lore",
            "cosmology",
            "system",
            "item",
            "creature",
            "culture",
            "quest",
            "timeline_event",
            "term",
            "core"
          ]
        },
        "subdir": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$",
          "description": "Directory under the type's root, e.g. 'nations' or 'weapons'."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "summary_line": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "nation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]+\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "introduced_in": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "spoiler_level": {
          "enum": [
            "none",
            "minor",
            "major"
          ]
        },
        "availability": {
          "enum": [
            "permanent",
            "limited",
            "removed",
            "mixed"
          ]
        },
        "related": {
          "$ref": "common.schema.json#/$defs/id_list"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "knowledge": {
          "$ref": "#/$defs/knowledge"
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uncertainty"
          }
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "status": {
          "enum": [
            "researching",
            "drafted",
            "needs_verification",
            "verified"
          ]
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "wi": {
          "$ref": "#/$defs/wi"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "facts": {
          "type": "object"
        }
      }
    }
  }
}
